# Copier en .env.test et pointer vers une base PostgreSQL DÉDIÉE AUX TESTS
# (jamais la base de développement : les tests nettoient les tables à chaque run).
DATABASE_URL="postgresql://user:password@localhost:5432/boutique_test_db?schema=public"
JWT_SECRET="test_secret_key"
JWT_EXPIRES_IN="1h"
PORT=4001
FRONTEND_URL="http://localhost:5500"
